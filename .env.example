APP_NAME="Laravel Clutch demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file

# Runs are queued, so the demo needs a worker:
#   php artisan queue:work --queue=agents
QUEUE_CONNECTION=database
CLUTCH_QUEUE=agents

# Required. The agent talks to a real model.
ANTHROPIC_API_KEY=
