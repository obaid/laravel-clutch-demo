APP_NAME="Clutch CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file

# Runs are queued, so the demo needs a worker:
#   php artisan queue:work --queue=agents
QUEUE_CONNECTION=database
CLUTCH_QUEUE=agents

# Which provider answers. Anything Laravel AI supports works here; these two
# are the ones the demo is written against.
AI_PROVIDER=openai

# Optional. Blank lets the provider choose its own default, which is gpt-5.4 on
# OpenAI and claude-sonnet-5 on Anthropic.
AI_MODEL=

# Set the key for whichever provider you chose above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
